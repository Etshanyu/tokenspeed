{
  "name": "tokenspeed",
  "version": "0.1.0",
  "description": "Local-first token telemetry TUI for Claude Code, Codex and DSH",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tokenspeed": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "dsh",
    "token-usage",
    "tui",
    "observability"
  ],
  "scripts": {
    "start": "tsx src/main.tsx",
    "start:built": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/benchmark.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "ink": "^8.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
